   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "id": "7_uaW3JfWbdp"
   },
   "outputs": [],
   "source": [
    "# Select one model below by uncommenting the line you want to use 👇\n",
